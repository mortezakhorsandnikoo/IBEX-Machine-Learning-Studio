<Page x:Class="ArchiAI.Views.MLView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:ArchiAI.Views"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Background="Transparent">
    <Page.Resources>
        <!-- Consistent light workspace defaults. -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#172B45"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#172B45"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <!-- Explicit dropdown surfaces preserve contrast in the light workspace. -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#172B45"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#E2E7EF"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="#E2E7EF" BorderThickness="1" CornerRadius="4"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ToggleButton.Background>
                                    <SolidColorBrush Color="#F1F5F9"/>
                                </ToggleButton.Background>
                            </ToggleButton>
                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                  Data="M0,0 L10,0 L5,6 Z" Fill="#087F73"/>
                            <ContentPresenter Margin="10,0,26,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              IsHitTestVisible="False"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#FFFFFF" BorderBrush="#E2E7EF" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="280"><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E2E7EF"/>
            <Setter Property="Foreground" Value="#172B45"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Page.Resources>
    <Grid Background="#F4F6FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Persistent actions on every workspace page; advanced formatting stays optional. -->
        <StackPanel Grid.Row="0" Margin="16,10,16,6">
            <WrapPanel>
                <Button x:Name="SavePageButton" Content="Save page image" Click="MlSavePage_Click" Background="White" Foreground="#087F73" Padding="12,8" Margin="0,0,8,4"/>
                <Button x:Name="SaveChartsButton" Content="Save charts / images" Click="MlSaveDiagrams_Click" Background="White" Foreground="#087F73" Padding="12,8" Margin="0,0,8,4"/>
                <Button x:Name="SaveTablesButton" Content="Save tables (CSV)" Click="MlSaveTables_Click" Background="White" Foreground="#087F73" Padding="12,8" Margin="0,0,8,4"/>
                <Button x:Name="ResetPageButton" Content="Reset page" Click="ResetPage_Click" Background="White" Foreground="#087F73" Padding="12,8" Margin="0,0,16,4"/>
                <TextBlock x:Name="ExportStatus" VerticalAlignment="Center" Foreground="#64748B" TextWrapping="Wrap"/>
            </WrapPanel>
            <Expander Header="Export formatting" Foreground="#64748B" Margin="0,4,0,0">
                <WrapPanel Margin="0,10,0,8">
            <TextBlock Text="Label size:" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="MlLabelBox" Text="30" Width="42" Background="#F4F6FA" Foreground="#172B45" BorderBrush="#E2E7EF" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Title size:" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="MlTitleBox" Text="36" Width="42" Background="#F4F6FA" Foreground="#172B45" BorderBrush="#E2E7EF" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Number size:" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="MlNumBox" Text="28" Width="42" Background="#F4F6FA" Foreground="#172B45" BorderBrush="#E2E7EF" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Line width:" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="MlLineBox" Text="6" Width="42" Background="#F4F6FA" Foreground="#172B45" BorderBrush="#E2E7EF" VerticalAlignment="Center"/>
                </WrapPanel>
            </Expander>
        </StackPanel>

        <TabControl Grid.Row="1" x:Name="MainTabs" Background="#F4F6FA"
                BorderThickness="0" Padding="0" Margin="0" SelectionChanged="MainTabs_SelectionChanged_1">
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
            </ControlTemplate>
        </TabControl.Template>
        <!-- ==================== TAB 1: DATA ==================== -->
        <TabItem Header=" Data">
            <Grid Background="#F4F6FA">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Top bar -->
                <StackPanel Orientation="Horizontal" Margin="10">
                    <Button x:Name="ImportDatasetButton" Content="Import dataset" Click="LoadCsv_Click"
                            Background="#087F73" Foreground="White" FontWeight="SemiBold" Padding="16,10"
                            ToolTip="Load a CSV dataset"/>
                    <TextBlock x:Name="TxtFileName" Text="Import a CSV to get started."
                               Foreground="#64748B" VerticalAlignment="Center"
                               Margin="15,0,0,0" FontSize="14"/>
                </StackPanel>
                <!-- Main content -->
                <Grid Grid.Row="1" Margin="10,0,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>
                    <!-- Data Preview -->
                    <Border Background="#FFFFFF" CornerRadius="8" Padding="5" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Data Preview" Foreground="#172B45" FontSize="16"
                                       FontWeight="Bold" Margin="10,5"/>
                            <DataGrid x:Name="DataPreview" Grid.Row="1"
                                      Background="#FFFFFF" Foreground="#172B45"
                                      RowBackground="#FFFFFF" AlternatingRowBackground="#F1F5F9"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E2E7EF"
                                      BorderThickness="0" IsReadOnly="True" AutoGenerateColumns="True"
                                      HeadersVisibility="Column" CanUserAddRows="False"
                                      FontSize="12">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#E2E7EF"/>
                                        <Setter Property="Foreground" Value="#087F73"/>
                                        <Setter Property="Padding" Value="8,5"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="BorderBrush" Value="#F4F6FA"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <!-- Right panel: Stats + Correlation -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Dataset Info -->
                            <Border Background="#FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Dataset Info" Foreground="#087F73"
                                               FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="TxtDataInfo" Foreground="#172B45"
                                               FontSize="13" TextWrapping="Wrap"
                                               Text="Load a CSV to see info."/>
                                </StackPanel>
                            </Border>
                            <!-- Column Statistics -->
                            <Border Background="#FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Column Statistics" Foreground="#087F73"
                                               FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <ComboBox x:Name="CmbStatCol" Background="#F1F5F9" Foreground="#172B45"
                                              FontSize="13" Padding="8,5"
                                              SelectionChanged="StatCol_Changed"/>
                                    <TextBlock x:Name="TxtColStats" Foreground="#172B45"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                                               FontFamily="Consolas"/>
                                </StackPanel>
                            </Border>
                            <!-- Histogram -->
                            <Border Background="#FFFFFF" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Histogram" Foreground="#087F73"
                                               FontSize="14" FontWeight="Bold" Margin="5,0,0,5"/>
                                    <lvc:CartesianChart x:Name="HistChart" Height="180"/>
                                </StackPanel>
                            </Border>
                            <!-- Correlation Matrix -->
                            <Border Background="#FFFFFF" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Correlation Matrix" Foreground="#087F73"
                                               FontSize="14" FontWeight="Bold" Margin="5,0,0,5"/>
                                    <Canvas x:Name="CorrCanvas" Height="300"
                                            Background="#FFFFFF" ClipToBounds="True" SizeChanged="CorrCanvas_SizeChanged"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <!-- Status -->
                <Border Grid.Row="2" Background="#FFFFFF" Padding="10,5">
                    <TextBlock x:Name="TxtDataStatus" Text="Ready" Foreground="#087F73" FontSize="12"/>
                </Border>
            </Grid>
        </TabItem>
        <!-- ==================== TAB 2: PREPROCESSING ==================== -->
        <TabItem Header=" Preprocessing">
            <Grid Background="#F4F6FA">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- LEFT: Controls -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <!-- DESCRIBE -->
                        <Border Background="#FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text=" Describe" Foreground="#087F73"
                                   FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock Text="Computes full descriptive statistics for every column."
                                   Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Button Content="▶ Run Describe" Click="Describe_Click"
                                Background="#E2E7EF" Foreground="#172B45" Padding="10,8"
                                BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                        <!-- MISSING VALUES -->
                        <Border Background="#FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text=" Missing Values" Foreground="#087F73"
                                   FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                <Button Content="▶ Detect Missing" Click="DetectMissing_Click"
                                Background="#E2E7EF" Foreground="#172B45" Padding="10,8"
                                BorderThickness="0" Cursor="Hand" Margin="0,0,0,8"/>
                                <TextBlock Text="Handle Method:" Foreground="#172B45" FontSize="12"/>
                                <ComboBox x:Name="CmbMissingMethod" Background="#F1F5F9" Foreground="#172B45"
                                  FontSize="12" Padding="8,5" Margin="0,3,0,8" SelectedIndex="0">
                                    <ComboBoxItem Content="Mean"/>
                                    <ComboBoxItem Content="Max"/>
                                    <ComboBoxItem Content="Min"/>
                                    <ComboBoxItem Content="Mode"/>
                                    <ComboBoxItem Content="Remove Row"/>
                                </ComboBox>
                                <Button Content="▶ Handle Missing" Click="HandleMissing_Click"
                                Background="#E2E7EF" Foreground="#172B45" Padding="10,8"
                                BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                        <!-- ANOMALY DETECTION -->
                        <Border Background="#FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text=" Anomaly Detection" Foreground="#087F73"
                                   FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock Text="Gaussian (Mahalanobis)" Foreground="#64748B" FontSize="11"
                                   Margin="0,0,0,5"/>
                                <TextBlock Text="Threshold:" Foreground="#172B45" FontSize="12"/>
                                <TextBox x:Name="TxtAnomalyThreshold" Text="0.001" FontSize="12"
                                 Background="#F1F5F9" Foreground="#172B45" Padding="8,5"
                                 BorderBrush="#E2E7EF" Margin="0,3,0,8"/>
                                <CheckBox x:Name="ChkRemoveAnomalies" Content="Remove anomalies from data"
                                  Foreground="#172B45" FontSize="12" Margin="0,0,0,8"/>
                                <Button Content="▶ Detect Anomalies" Click="Anomaly_Click"
                                Background="#E2E7EF" Foreground="#172B45" Padding="10,8"
                                BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                        <!-- NORMALIZE -->
                        <Border Background="#FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text=" Normalize" Foreground="#087F73"
                                   FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ComboBox x:Name="CmbNormMethod" Background="#F1F5F9" Foreground="#172B45"
                                  FontSize="12" Padding="8,5" Margin="0,3,0,8" SelectedIndex="0">
                                    <ComboBoxItem Content="Z-Score Standardization"/>
                                    <ComboBoxItem Content="Min-Max Normalization"/>
                                    <ComboBoxItem Content="Max-Absolute Scaling"/>
                                </ComboBox>
                                <Button Content="▶ Normalize" Click="Normalize_Click"
                                Background="#E2E7EF" Foreground="#172B45" Padding="10,8"
                                BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                        <!-- LABEL ENCODER -->
                        <Border Background="#FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text=" Label Encoder" Foreground="#087F73"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock Text="Converts categorical (text) columns to numeric values. Auto-detects non-numeric columns or specify manually."
                   Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Text="Column indices (comma-separated, leave empty for auto):"
                   Foreground="#172B45" FontSize="11" TextWrapping="Wrap"/>
                                <TextBox x:Name="TxtEncoderCols" Text="" FontSize="12"
                 Background="#F1F5F9" Foreground="#172B45" Padding="8,5"
                 BorderBrush="#E2E7EF" Margin="0,3,0,8"/>
                                <Button Content="▶ Encode Labels" Click="LabelEncode_Click"
                Background="#E2E7EF" Foreground="#172B45" Padding="10,8"
                BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                        <!-- PCA -->
                        <Border Background="#FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text=" PCA" Foreground="#087F73"
                                   FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock Text="Mode:" Foreground="#172B45" FontSize="12"/>
                                <ComboBox x:Name="CmbPcaMode" Background="#F1F5F9" Foreground="#172B45"
                                  FontSize="12" Padding="8,5" Margin="0,3,0,5" SelectedIndex="0">
                                    <ComboBoxItem Content="Variance Threshold"/>
                                    <ComboBoxItem Content="Fixed Components"/>
                                </ComboBox>
                                <TextBlock Text="Value (0-1 for variance, integer for components):"
                                   Foreground="#172B45" FontSize="11" TextWrapping="Wrap"/>
                                <TextBox x:Name="TxtPcaValue" Text="0.95" FontSize="12"
                                 Background="#F1F5F9" Foreground="#172B45" Padding="8,5"
                                 BorderBrush="#E2E7EF" Margin="0,3,0,5"/>
                                <CheckBox x:Name="ChkPcaHasTarget" Content="Last column is target (Y)"
                                  IsChecked="True"
                                  Foreground="#172B45" FontSize="12" Margin="0,0,0,8"/>
                                <Button Content="▶ Run PCA" Click="Pca_Click"
                                Background="#E2E7EF" Foreground="#172B45" Padding="10,8"
                                BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                        <!-- Status -->
                        <Border Background="#FFFFFF" CornerRadius="8" Padding="15">
                            <TextBlock x:Name="TxtPrepStatus" Foreground="#087F73" FontSize="12"
                               TextWrapping="Wrap" Text="Load data in Data tab first."/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <!-- RIGHT: Results -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PrepResultsPanel" Margin="10">
                        <!-- Describe Table -->
                        <Border x:Name="DescribeBorder" Background="#FFFFFF" CornerRadius="8"
                        Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Descriptive Statistics" Foreground="#087F73"
                                   FontSize="16" FontWeight="Bold" Margin="5,0,0,5"/>
                                <DataGrid x:Name="DescribeGrid"
                                  Background="#FFFFFF" Foreground="#172B45"
                                  RowBackground="#FFFFFF" AlternatingRowBackground="#F1F5F9"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E7EF"
                                  BorderThickness="0" IsReadOnly="True" AutoGenerateColumns="True"
                                  HeadersVisibility="Column" CanUserAddRows="False" FontSize="11"
                                  MaxHeight="400">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#E2E7EF"/>
                                            <Setter Property="Foreground" Value="#087F73"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="BorderBrush" Value="#F4F6FA"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                        <!-- Missing Value Report -->
                        <Border x:Name="MissingBorder" Background="#FFFFFF" CornerRadius="8"
                        Padding="15" Margin="0,0,0,10" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Missing Value Report" Foreground="#087F73"
                                   FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtMissingReport" Foreground="#172B45"
                                   FontSize="12" FontFamily="Consolas" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <!-- Missing Per Column Chart -->
                        <Border x:Name="MissingChartBorder" Background="#FFFFFF" CornerRadius="8"
                        Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Missing Values Per Column" Foreground="#087F73"
                                   FontSize="14" FontWeight="Bold" Margin="5,0,0,5"/>
                                <lvc:CartesianChart x:Name="MissingChart" Height="200"/>
                            </StackPanel>
                        </Border>
                        <!-- Anomaly Report -->
                        <Border x:Name="AnomalyBorder" Background="#FFFFFF" CornerRadius="8"
                        Padding="15" Margin="0,0,0,10" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Anomaly Detection Results" Foreground="#087F73"
                                   FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtAnomalyReport" Foreground="#172B45"
                                   FontSize="12" FontFamily="Consolas" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <!-- Anomaly Score Distribution -->
                        <Border x:Name="AnomalyChartBorder" Background="#FFFFFF" CornerRadius="8"
                        Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Mahalanobis Distance Distribution" Foreground="#087F73"
                                   FontSize="14" FontWeight="Bold" Margin="5,0,0,5"/>
                                <lvc:CartesianChart x:Name="AnomalyChart" Height="220"/>
                            </StackPanel>
                        </Border>
                        <!-- Normalize Preview -->
                        <Border x:Name="NormalizeBorder" Background="#FFFFFF" CornerRadius="8"
                        Padding="15" Margin="0,0,0,10" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="TxtNormTitle" Text="Normalized Data" Foreground="#087F73"
                                   FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                <DataGrid x:Name="NormalizeGrid"
                                  Background="#FFFFFF" Foreground="#172B45"
                                  RowBackground="#FFFFFF" AlternatingRowBackground="#F1F5F9"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E7EF"
                                  BorderThickness="0" IsReadOnly="True" AutoGenerateColumns="True"
                                  HeadersVisibility="Column" CanUserAddRows="False" FontSize="11"
                                  MaxHeight="300">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#E2E7EF"/>
                                            <Setter Property="Foreground" Value="#087F73"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderBrush" Value="#F4F6FA"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                        <!-- Normalize Before/After Chart -->
                        <Border x:Name="NormChartBorder" Background="#FFFFFF" CornerRadius="8"
                        Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Before vs After (Column Ranges)" Foreground="#087F73"
                                   FontSize="14" FontWeight="Bold" Margin="5,0,0,5"/>
                                <lvc:CartesianChart x:Name="NormChart" Height="220"/>
                            </StackPanel>
                        </Border>
                        <!-- Label Encoder Results -->
                        <Border x:Name="EncoderBorder" Background="#FFFFFF" CornerRadius="8"
        Padding="15" Margin="0,0,0,10" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text=" Label Encoding Results" Foreground="#087F73"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtEncoderReport" Foreground="#172B45"
                   FontSize="12" FontFamily="Consolas" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <!-- Encoded Data Preview -->
                        <Border x:Name="EncoderPreviewBorder" Background="#FFFFFF" CornerRadius="8"
        Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Encoded Data Preview" Foreground="#087F73"
                   FontSize="14" FontWeight="Bold" Margin="5,0,0,5"/>
                                <DataGrid x:Name="EncoderGrid"
                  Background="#FFFFFF" Foreground="#172B45"
                  RowBackground="#FFFFFF" AlternatingRowBackground="#F1F5F9"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E7EF"
                  BorderThickness="0" IsReadOnly="True" AutoGenerateColumns="True"
                  HeadersVisibility="Column" CanUserAddRows="False" FontSize="11"
                  MaxHeight="300">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#E2E7EF"/>
                                            <Setter Property="Foreground" Value="#087F73"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="BorderBrush" Value="#F4F6FA"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                        <!-- PCA Results -->
                        <Border x:Name="PcaBorder" Background="#FFFFFF" CornerRadius="8"
                        Padding="15" Margin="0,0,0,10" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="PCA Results" Foreground="#087F73"
                                   FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtPcaReport" Foreground="#172B45"
                                   FontSize="12" FontFamily="Consolas" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <!-- PCA Scree Plot -->
                        <Border x:Name="PcaScreeBorder" Background="#FFFFFF" CornerRadius="8"
                        Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Scree Plot (Explained Variance)" Foreground="#087F73"
                                   FontSize="14" FontWeight="Bold" Margin="5,0,0,5"/>
                                <lvc:CartesianChart x:Name="ScreeChart" Height="220"/>
                            </StackPanel>
                        </Border>
                        <!-- PCA Cumulative Variance -->
                        <Border x:Name="PcaCumBorder" Background="#FFFFFF" CornerRadius="8"
                        Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Cumulative Variance" Foreground="#087F73"
                                   FontSize="14" FontWeight="Bold" Margin="5,0,0,5"/>
                                <lvc:CartesianChart x:Name="CumVarChart" Height="220"/>
                            </StackPanel>
                        </Border>
                        <!-- PCA 2D Projection -->
                        <Border x:Name="PcaScatterBorder" Background="#FFFFFF" CornerRadius="8"
                        Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="2D PCA Projection" Foreground="#087F73"
                                   FontSize="14" FontWeight="Bold" Margin="5,0,0,5"/>
                                <lvc:CartesianChart x:Name="PcaScatterChart" Height="280"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </TabItem>
        <!-- ==================== TAB 3: REGRESSION (algorithm dropdown) ==================== -->
        <TabItem Header=" Regression">
            <Grid Background="#F4F6FA">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Algorithm selector bar -->
                <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="8" Padding="10" Margin="10,10,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Algorithm:" Foreground="#087F73" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="4,0,10,0" FontSize="14"/>
                        <ComboBox x:Name="CmbRegAlgo" Width="240" Height="30"
                                  Background="#F1F5F9" Foreground="#172B45"
                                  SelectedIndex="0" SelectionChanged="RegAlgo_Changed">
                            <ComboBoxItem Content="Linear Regression"/>
                            <ComboBoxItem Content="Polynomial Regression"/>
                            <ComboBoxItem Content="Normal Equation"/>
                            <ComboBoxItem Content="Locally Weighted Regression"/>
                            <ComboBoxItem Content="Random Forest"/>
                            <ComboBoxItem Content="Neural Net (MLP)"/>
                            <ComboBoxItem Content="RBF Surrogate"/>
                            <ComboBoxItem Content="FastTree (boosted)"/>
                            <ComboBoxItem Content="LightGBM"/>
                            <ComboBoxItem Content="Online Gradient Descent"/>
                            <ComboBoxItem Content="XGBoost"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
                <!-- Panel host: only the selected algorithm's panel is visible -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <!-- ============ LINEAR REGRESSION PANEL ============ -->
                    <Grid x:Name="PanelLinear" Background="#F4F6FA" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- LEFT: Parameters -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <Border Background="#FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Parameters" Foreground="#087F73"
                                                   FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                                        <TextBlock Text="Target Column" Foreground="#172B45" FontSize="13"/>
                                        <ComboBox x:Name="CmbTarget" Background="#F1F5F9" Foreground="#172B45"
                                                  FontSize="13" Padding="8,5" Margin="0,3,0,10"/>
                                        <TextBlock Text="Iterations" Foreground="#172B45" FontSize="13"/>
                                        <TextBox x:Name="TxtIter" Text="100" FontSize="13"
                                                 Background="#F1F5F9" Foreground="#172B45" Padding="8,5"
                                                 BorderBrush="#E2E7EF" Margin="0,3,0,10"/>
                                        <TextBlock Text="Learning Rate" Foreground="#172B45" FontSize="13"/>
                                        <TextBox x:Name="TxtLR" Text="0.01" FontSize="13"
                                                 Background="#F1F5F9" Foreground="#172B45" Padding="8,5"
                                                 BorderBrush="#E2E7EF" Margin="0,3,0,10"/>
                                        <TextBlock Text="Regularization" Foreground="#172B45" FontSize="13"/>
                                        <ComboBox x:Name="CmbReg" Background="#F1F5F9" Foreground="#172B45"
                                                  FontSize="13" Padding="8,5" Margin="0,3,0,10"
                                                  SelectedIndex="2">
                                            <ComboBoxItem Content="L1 (LASSO)"/>
                                            <ComboBoxItem Content="L2 (Ridge)"/>
                                            <ComboBoxItem Content="None"/>
                                        </ComboBox>
                                        <TextBlock Text="Train/Test Split" Foreground="#172B45" FontSize="13"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,10">
                                            <Slider x:Name="SliderSplit" Width="180" Minimum="50" Maximum="90"
                                                    Value="80" IsSnapToTickEnabled="True" TickFrequency="5"
                                                    ValueChanged="Split_Changed"/>
                                            <TextBlock x:Name="TxtSplit" Text="80/20" Foreground="#172B45"
                                                       FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkKFold" Content="Use K-Fold CV"
                                                  Foreground="#172B45" FontSize="13" Margin="0,0,0,6"/>
                                        <TextBlock Text="Folds (k)" Foreground="#172B45" FontSize="13"/>
                                        <TextBox x:Name="TxtFolds" Text="5" FontSize="13"
                                                 Background="#F1F5F9" Foreground="#172B45" Padding="8,5"
                                                 BorderBrush="#E2E7EF" Margin="0,3,0,10"/>
                                        <Button Content="Train model" Click="Train_Click"
                                                Background="#087F73" Foreground="#F4F6FA" FontWeight="Bold"
                                                FontSize="15" Padding="10,12" BorderThickness="0"
                                                Cursor="Hand"/>
                                    </StackPanel>
                                </Border>
                                <!-- Results Summary (read-only TextBox = selectable/copyable) -->
                                <Border Background="#FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Results" Foreground="#087F73"
                                                   FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                                        <TextBox x:Name="TxtResults" Foreground="#172B45"
                                                 FontSize="12" FontFamily="Consolas" TextWrapping="Wrap"
                                                 IsReadOnly="True" IsTabStop="False" BorderThickness="0"
                                                 Background="Transparent" Cursor="IBeam"
                                                 Text="Train a model to see results."/>
                                    </StackPanel>
                                </Border>
                                <!-- Weights (read-only TextBox = selectable/copyable) -->
                                <Border Background="#FFFFFF" CornerRadius="8" Padding="15">
                                    <StackPanel>
                                        <TextBlock Text="Model Weights" Foreground="#087F73"
                                                   FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <TextBox x:Name="TxtWeights" Foreground="#172B45"
                                                 FontSize="11" FontFamily="Consolas" TextWrapping="Wrap"
                                                 IsReadOnly="True" IsTabStop="False" BorderThickness="0"
                                                 Background="Transparent" Cursor="IBeam"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFFFFF" CornerRadius="8" Padding="15" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Predict (enter feature values)" Foreground="#087F73"
                                           FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <StackPanel x:Name="LinPredictInputs"/>
                                        <Button Content="Predict" Click="LinPredict_Click"
                                        Background="#E2E7EF" Foreground="#087F73"
                                        Height="32" Margin="0,10,0,6" FontWeight="Bold"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Save Model" Click="SaveLinModel_Click"
                                            Background="#F1F5F9" Foreground="#172B45"
                                            Height="28" Padding="10,0" Margin="0,0,6,6"/>
                                            <Button Content="Load Model" Click="LoadLinModel_Click"
                                            Background="#F1F5F9" Foreground="#172B45"
                                            Height="28" Padding="10,0" Margin="0,0,0,6"/>
                                        </StackPanel>
                                        <TextBlock x:Name="LinPredictResult" Foreground="#172B45"
                                           FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <!-- RIGHT: Charts -->
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <local:CrossValidationTable x:Name="LinCvTable"/>
                                <!-- Cost History -->
                                <Border Background="#FFFFFF" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Cost History (Loss Curve)" Foreground="#087F73"
                                                   FontSize="14" FontWeight="Bold" Margin="5,0,0,5"/>
                                        <lvc:CartesianChart x:Name="CostChart" Height="220"/>
                                    </StackPanel>
                                </Border>
                                <!-- Actual vs Predicted -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#FFFFFF" CornerRadius="8" Padding="10" Margin="0,0,5,0">
                                        <StackPanel>
                                            <TextBlock Text="Train: Actual vs Predicted" Foreground="#087F73"
                                                       FontSize="13" FontWeight="Bold" Margin="5,0,0,5"/>
                                            <lvc:CartesianChart x:Name="TrainScatter" Height="250"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="8"
                                            Padding="10" Margin="5,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Test: Actual vs Predicted" Foreground="#087F73"
                                                       FontSize="13" FontWeight="Bold" Margin="5,0,0,5"/>
                                            <lvc:CartesianChart x:Name="TestScatter" Height="250"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <!-- Residuals -->
                                <Border Background="#FFFFFF" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Residual Plot (Test Set)" Foreground="#087F73"
                                                   FontSize="14" FontWeight="Bold" Margin="5,0,0,5"/>
                                        <lvc:CartesianChart x:Name="ResidualChart" Height="220"/>
                                    </StackPanel>
                                </Border>
                                <!-- Feature Importance -->
                                <Border Background="#FFFFFF" CornerRadius="8" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="Feature Importance (|Weight|)" Foreground="#087F73"
                                                   FontSize="14" FontWeight="Bold" Margin="5,0,0,5"/>
                                        <lvc:CartesianChart x:Name="ImportanceChart" Height="200"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <!-- ============ POLYNOMIAL REGRESSION PANEL ============ -->
                    <Grid x:Name="PanelPoly" Background="#F4F6FA" Visibility="Collapsed"
                          IsVisibleChanged="PolyPanel_IsVisibleChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Controls -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Border Background="#FFFFFF" CornerRadius="8" Padding="15" Margin="10">
                                <StackPanel>
                                    <TextBlock Text="Polynomial Regression" Foreground="#087F73"
                                               FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                                    <TextBlock Text="Target Column" Foreground="#172B45" FontSize="13"/>
                                    <ComboBox x:Name="PolyTargetCombo" Background="#F1F5F9" Foreground="#172B45"
                                              FontSize="13" Padding="8,5" Margin="0,3,0,10"/>
                                    <TextBlock Text="Degree" Foreground="#172B45" FontSize="13"/>
                                    <TextBox x:Name="PolyDegreeBox" Text="2" FontSize="13"
                                             Background="#F1F5F9" Foreground="#172B45" Padding="8,5"
                                             BorderBrush="#E2E7EF" Margin="0,3,0,10"/>
                                    <TextBlock Text="Learning Rate" Foreground="#172B45" FontSize="13"/>
                                    <TextBox x:Name="PolyLearningRateBox" Text="0.01" FontSize="13"
                                             Background="#F1F5F9" Foreground="#172B45" Padding="8,5"
                                             BorderBrush="#E2E7EF" Margin="0,3,0,10"/>
                                    <TextBlock Text="Iterations" Foreground="#172B45" FontSize="13"/>
                                    <TextBox x:Name="PolyIterationsBox" Text="1000" FontSize="13"
                                             Background="#F1F5F9" Foreground="#172B45" Padding="8,5"
                                             BorderBrush="#E2E7EF" Margin="0,3,0,10"/>
                                    <CheckBox x:Name="PolyUseCV" Content="Use K-Fold CV"
                                              Foreground="#172B45" FontSize="13" Margin="0,4,0,6"/>
                                    <TextBlock Text="Folds (k)" Foreground="#172B45" FontSize="13"/>
                                    <TextBox x:Name="PolyFoldsBox" Text="5" FontSize="13"
                                             Background="#F1F5F9" Foreground="#172B45" Padding="8,5"
                                             BorderBrush="#E2E7EF" Margin="0,3,0,10"/>
                                    <TextBlock x:Name="PolySplitLabel" Text="Train: 80 % / Test: 20 %"
                                               Foreground="#172B45" FontSize="13" Margin="0,0,0,4"/>
                                    <Slider x:Name="PolySplitSlider" Minimum="0.5" Maximum="0.95" Value="0.8"
                                            TickFrequency="0.05" IsSnapToTickEnabled="True"
                                            ValueChanged="PolySplit_Changed" Margin="0,0,0,15"/>
                                    <Button Content="Train model" Click="PolyTrain_Click"
                                            Background="#087F73" Foreground="#F4F6FA" FontWeight="Bold"
                                            FontSize="15" Padding="10,12" BorderThickness="0" Cursor="Hand"/>
                                    <TextBlock Text="Metrics" Foreground="#087F73" FontWeight="Bold"
                                               FontSize="14" Margin="0,18,0,4"/>
                                    <TextBox x:Name="PolyMetricsText" Foreground="#172B45"
                                             FontSize="12" FontFamily="Consolas" TextWrapping="Wrap"
                                             IsReadOnly="True" IsTabStop="False" BorderThickness="0"
                                             Background="Transparent" Cursor="IBeam"/>
                                    <TextBlock Text="Equation" Foreground="#087F73" FontWeight="Bold"
                                               FontSize="14" Margin="0,14,0,4"/>
                                    <TextBox x:Name="PolyEquationText" Foreground="#172B45"
                                             FontSize="12" FontFamily="Consolas" TextWrapping="Wrap"
                                             IsReadOnly="True" IsTabStop="False" BorderThickness="0"
                                             Background="Transparent" Cursor="IBeam"/>
                                    <TextBlock Text="Predict (enter feature values)" Foreground="#087F73"
                                               FontSize="14" FontWeight="Bold" Margin="0,18,0,8"/>
                                    <StackPanel x:Name="PolyPredictInputs"/>
                                    <Button Content="Predict" Click="PolyPredict_Click"
                                            Background="#E2E7EF" Foreground="#087F73"
                                            Height="32" Margin="0,10,0,6" FontWeight="Bold"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Save Model" Click="SavePolyModel_Click"
                                                Background="#F1F5F9" Foreground="#172B45"
                                                Height="28" Padding="10,0" Margin="0,0,6,6"/>
                                        <Button Content="Load Model" Click="LoadPolyModel_Click"
                                                Background="#F1F5F9" Foreground="#172B45"
                                                Height="28" Padding="10,0" Margin="0,0,0,6"/>
                                    </StackPanel>
                                    <TextBlock x:Name="PolyPredictResult" Foreground="#172B45"
               FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                        <!-- Each chart has a bounded plot area; the results scroll on smaller windows. -->
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="10">
                                <Border Background="#E5F3F0" CornerRadius="8" Padding="16" Margin="4,0,4,10">
                                    <TextBlock x:Name="PolyChartStatus" Text="Ready to explore. Load a dataset, select a target and train your model to reveal the charts." TextWrapping="Wrap" Foreground="#087F73"/>
                                </Border>
                                <local:CrossValidationTable x:Name="PolyCvTable"/>
                                <Grid x:Name="PolyChartGrid">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Background="White" CornerRadius="10" Padding="16" Margin="4">
                                        <StackPanel>
                                            <TextBlock Text="Training loss" Foreground="#172B45" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="How error changes with each iteration" Foreground="#64748B" FontSize="11" Margin="0,4,0,12"/>
                                            <lvc:CartesianChart x:Name="PolyCostChart" Height="240"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="16" Margin="4">
                                        <StackPanel>
                                            <TextBlock Text="Actual vs predicted" Foreground="#172B45" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="PolyScatterCaption" Text="Teal: train · Blue: test · Dashed: ideal" Foreground="#64748B" FontSize="11" Margin="0,4,0,12"/>
                                            <lvc:CartesianChart x:Name="PolyScatterChart" Height="240"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16" Margin="4">
                                        <StackPanel>
                                            <TextBlock Text="Residuals" Foreground="#172B45" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="Prediction errors, centered around zero" Foreground="#64748B" FontSize="11" Margin="0,4,0,12"/>
                                            <lvc:CartesianChart x:Name="PolyResidualChart" Height="240"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1" Background="White" CornerRadius="10" Padding="16" Margin="4">
                                        <StackPanel>
                                            <TextBlock Text="Coefficient magnitude" Foreground="#172B45" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="Absolute weights in original feature units" Foreground="#64748B" FontSize="11" Margin="0,4,0,12"/>
                                            <lvc:CartesianChart x:Name="PolyImportanceChart" Height="240"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <!-- ============ ADVANCED (generic IRegressionModel) PANEL ============ -->
                    <Grid x:Name="PanelAdvanced" Background="#F4F6FA" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <Border Background="#FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Advanced Regression" Foreground="#087F73" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                                        <TextBlock Text="Target Column" Foreground="#172B45" FontSize="13"/>
                                        <ComboBox x:Name="CmbAdvTarget" Background="#F1F5F9" Foreground="#172B45" FontSize="13" Padding="8,5" Margin="0,3,0,10"/>
                                        <TextBlock Text="Hyperparameters" Foreground="#087F73" FontWeight="Bold" FontSize="13" Margin="0,4,0,4"/>
                                        <StackPanel x:Name="AdvHyperPanel"/>
                                        <TextBlock Text="Train/Test Split" Foreground="#172B45" FontSize="13" Margin="0,10,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,10">
                                            <Slider x:Name="SliderAdvSplit" Width="190" Minimum="50" Maximum="90" Value="80" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="AdvSplit_Changed"/>
                                            <TextBlock x:Name="TxtAdvSplit" Text="80/20" Foreground="#172B45" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkAdvKFold" Content="Use K-Fold CV" Foreground="#172B45" FontSize="13" Margin="0,0,0,6"/>
                                        <TextBlock Text="Folds (k)" Foreground="#172B45" FontSize="13"/>
                                        <TextBox x:Name="TxtAdvFolds" Text="5" FontSize="13" Background="#F1F5F9" Foreground="#172B45" Padding="8,5" BorderBrush="#E2E7EF" Margin="0,3,0,10"/>
                                        <CheckBox x:Name="ChkAdvCurves" Content="Compute Learning + Validation curves" IsChecked="True" Foreground="#172B45" FontSize="12" Margin="0,0,0,8"/>
                                        <Button x:Name="BtnAdvTrain" Content="Train model" Click="AdvTrain_Click" Background="#087F73" Foreground="#F4F6FA" FontWeight="Bold" FontSize="15" Padding="10,12" BorderThickness="0" Cursor="Hand"/>
                                        <ProgressBar x:Name="AdvProgress" Height="5" Margin="0,10,0,0" IsIndeterminate="False" Visibility="Collapsed" Background="#F1F5F9" Foreground="#087F73"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Metrics" Foreground="#087F73" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <TextBox x:Name="TxtAdvResults" Foreground="#172B45" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap" IsReadOnly="True" IsTabStop="False" BorderThickness="0" Background="Transparent" Cursor="IBeam" Text="Train a model to see results."/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFFFFF" CornerRadius="8" Padding="15">
                                    <StackPanel>
                                        <TextBlock Text="Predict (enter feature values)" Foreground="#087F73" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <StackPanel x:Name="AdvPredictInputs"/>
                                        <Button Content="Predict" Click="AdvPredict_Click" Background="#E2E7EF" Foreground="#087F73" Height="32" Margin="0,10,0,6" FontWeight="Bold"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Save Model" Click="AdvSaveModel_Click" Background="#F1F5F9" Foreground="#172B45" Height="28" Padding="10,0" Margin="0,0,6,6"/>
                                            <Button Content=" Load Model" Click="AdvLoadModel_Click" Background="#F1F5F9" Foreground="#172B45" Height="28" Padding="10,0" Margin="0,0,0,6"/>
                                        </StackPanel>
                                        <TextBlock x:Name="AdvPredictResult" Foreground="#172B45" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <local:CrossValidationTable x:Name="AdvCvTable"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Background="#FFFFFF" CornerRadius="8" Padding="10" Margin="0,0,5,0">
                                        <StackPanel><TextBlock Text="Actual vs Predicted (Test)" Foreground="#087F73" FontSize="13" FontWeight="Bold" Margin="5,0,0,5"/><lvc:CartesianChart x:Name="AdvScatter" Height="240"/></StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="8" Padding="10" Margin="5,0,0,0">
                                        <StackPanel><TextBlock Text="Residuals (Test)" Foreground="#087F73" FontSize="13" FontWeight="Bold" Margin="5,0,0,5"/><lvc:CartesianChart x:Name="AdvResidual" Height="240"/></StackPanel>
                                    </Border>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Background="#FFFFFF" CornerRadius="8" Padding="10" Margin="0,0,5,0">
                                        <StackPanel><TextBlock Text="Learning Curve (R² vs train size)" Foreground="#087F73" FontSize="13" FontWeight="Bold" Margin="5,0,0,5"/><lvc:CartesianChart x:Name="AdvLearnChart" Height="240"/></StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="8" Padding="10" Margin="5,0,0,0">
                                        <StackPanel><TextBlock Text="Validation Curve (R² vs hyperparameter)" Foreground="#087F73" FontSize="13" FontWeight="Bold" Margin="5,0,0,5"/><lvc:CartesianChart x:Name="AdvValChart" Height="240"/></StackPanel>
                                    </Border>
                                </Grid>
                                <Border x:Name="AdvTreeBorder" Background="#FFFFFF" CornerRadius="8" Padding="10" Visibility="Collapsed">
                                    <StackPanel><TextBlock Text="Tree Branching Diagram (first tree)" Foreground="#087F73" FontSize="13" FontWeight="Bold" Margin="5,0,0,5"/><Canvas x:Name="AdvTreeCanvas" Height="360" Background="#FFFFFF" ClipToBounds="True"/></StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </TabItem>
        <!-- ==================== TAB 4: CLASSIFICATION ==================== -->
        <TabItem Header=" Classification">
            <Grid Background="#F4F6FA" IsVisibleChanged="ClsPanel_IsVisibleChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- LEFT: params + predict -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <Border Background="#FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Classification" Foreground="#087F73"
                                           FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                                <TextBlock Text="Algorithm" Foreground="#172B45" FontSize="13"/>
                                <ComboBox x:Name="CmbClsAlgo" Background="#F1F5F9" Foreground="#172B45"
                                          FontSize="13" Padding="8,5" Margin="0,3,0,10" SelectedIndex="0"
                                          SelectionChanged="ClsAlgo_Changed">
                                    <ComboBoxItem Content="Logistic Regression"/>
                                    <ComboBoxItem Content="K-Nearest Neighbors"/>
                                    <ComboBoxItem Content="Naive Bayes"/>
                                    <ComboBoxItem Content="SVM (linear)"/>
                                    <ComboBoxItem Content="Random Forest"/>
                                    <ComboBoxItem Content="FastTree (boosted)"/>
                                    <ComboBoxItem Content="LightGBM"/>
                                    <ComboBoxItem Content="XGBoost"/>
                                    <ComboBoxItem Content="Neural Net (ANN)"/>
                                </ComboBox>
                                <TextBlock Text="Target (class) column" Foreground="#172B45" FontSize="13"/>
                                <ComboBox x:Name="CmbClsTarget" Background="#F1F5F9" Foreground="#172B45"
                                          FontSize="13" Padding="8,5" Margin="0,3,0,10"/>
                                <!-- Logistic params -->
                                <StackPanel x:Name="ClsLogRegParams">
                                    <TextBlock Text="Iterations" Foreground="#172B45" FontSize="13"/>
                                    <TextBox x:Name="TxtClsIter" Text="500" FontSize="13"
                                             Background="#F1F5F9" Foreground="#172B45" Padding="8,5"
                                             BorderBrush="#E2E7EF" Margin="0,3,0,10"/>
                                    <TextBlock Text="Learning Rate" Foreground="#172B45" FontSize="13"/>
                                    <TextBox x:Name="TxtClsLR" Text="0.1" FontSize="13"
                                             Background="#F1F5F9" Foreground="#172B45" Padding="8,5"
                                             BorderBrush="#E2E7EF" Margin="0,3,0,10"/>
                                </StackPanel>
                                <!-- KNN params -->
                                <StackPanel x:Name="ClsKnnParams" Visibility="Collapsed">
                                    <TextBlock Text="Neighbors (k)" Foreground="#172B45" FontSize="13"/>
                                    <TextBox x:Name="TxtClsK" Text="5" FontSize="13"
                                             Background="#F1F5F9" Foreground="#172B45" Padding="8,5"
                                             BorderBrush="#E2E7EF" Margin="0,3,0,10"/>
                                </StackPanel>
                                <!-- SVM params -->
                                <StackPanel x:Name="ClsSvmParams" Visibility="Collapsed">
                                    <TextBlock Text="C (regularization)" Foreground="#172B45" FontSize="13"/>
                                    <TextBox x:Name="TxtClsC" Text="1.0" FontSize="13"
                                             Background="#F1F5F9" Foreground="#172B45" Padding="8,5"
                                             BorderBrush="#E2E7EF" Margin="0,3,0,10"/>
                                    <TextBlock Text="(also uses Iterations + Learning Rate above)" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                </StackPanel>
                                <!-- Random Forest params -->
                                <StackPanel x:Name="ClsRfParams" Visibility="Collapsed">
                                    <TextBlock Text="Trees" Foreground="#172B45" FontSize="13"/>
                                    <TextBox x:Name="TxtClsTrees" Text="50" FontSize="13"
                                             Background="#F1F5F9" Foreground="#172B45" Padding="8,5"
                                             BorderBrush="#E2E7EF" Margin="0,3,0,10"/>
                                    <TextBlock Text="Max Depth" Foreground="#172B45" FontSize="13"/>
                                    <TextBox x:Name="TxtClsDepth" Text="12" FontSize="13"
                                             Background="#F1F5F9" Foreground="#172B45" Padding="8,5"
                                             BorderBrush="#E2E7EF" Margin="0,3,0,10"/>
                                    <TextBlock Text="Min Samples / Leaf" Foreground="#172B45" FontSize="13"/>
                                    <TextBox x:Name="TxtClsLeaf" Text="5" FontSize="13"
                                             Background="#F1F5F9" Foreground="#172B45" Padding="8,5"
                                             BorderBrush="#E2E7EF" Margin="0,3,0,10"/>
                                </StackPanel>
                                <!-- ANN params -->
                                <StackPanel x:Name="ClsAnnParams" Visibility="Collapsed">
                                    <TextBlock Text="Hidden Size" Foreground="#172B45" FontSize="13"/>
                                    <TextBox x:Name="TxtClsAnnHidden" Text="32" FontSize="13"
                                             Background="#F1F5F9" Foreground="#172B45" Padding="8,5"
                                             BorderBrush="#E2E7EF" Margin="0,3,0,10"/>
                                    <TextBlock Text="Hidden Layers" Foreground="#172B45" FontSize="13"/>
                                    <TextBox x:Name="TxtClsAnnLayers" Text="1" FontSize="13"
                                             Background="#F1F5F9" Foreground="#172B45" Padding="8,5"
                                             BorderBrush="#E2E7EF" Margin="0,3,0,10"/>
                                    <TextBlock Text="(also uses Iterations=epochs + Learning Rate above)" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                </StackPanel>
                                <TextBlock Text="Train/Test Split" Foreground="#172B45" FontSize="13"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,10">
                                    <Slider x:Name="SliderClsSplit" Width="190" Minimum="50" Maximum="90"
                                            Value="80" IsSnapToTickEnabled="True" TickFrequency="5"
                                            ValueChanged="ClsSplit_Changed"/>
                                    <TextBlock x:Name="TxtClsSplit" Text="80/20" Foreground="#172B45"
                                               FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkClsKFold" Content="Use K-Fold CV"
                                          Foreground="#172B45" FontSize="13" Margin="0,0,0,6"/>
                                <TextBlock Text="Folds (k)" Foreground="#172B45" FontSize="13"/>
                                <TextBox x:Name="TxtClsFolds" Text="5" FontSize="13"
                                         Background="#F1F5F9" Foreground="#172B45" Padding="8,5"
                                         BorderBrush="#E2E7EF" Margin="0,3,0,10"/>
                                <Button Content="Train model" Click="ClsTrain_Click"
                                        Background="#087F73" Foreground="#F4F6FA" FontWeight="Bold"
                                        FontSize="15" Padding="10,12" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Results" Foreground="#087F73"
                                           FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBox x:Name="TxtClsResults" Foreground="#172B45"
                                         FontSize="12" FontFamily="Consolas" TextWrapping="Wrap"
                                         IsReadOnly="True" IsTabStop="False" BorderThickness="0"
                                         Background="Transparent" Cursor="IBeam"
                                         Text="Train a model to see results."/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FFFFFF" CornerRadius="8" Padding="15">
                            <StackPanel>
                                <TextBlock Text="Predict (enter feature values)" Foreground="#087F73"
                                           FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                                <StackPanel x:Name="ClsPredictInputs"/>
                                <Button Content="Predict" Click="ClsPredict_Click"
                                        Background="#E2E7EF" Foreground="#087F73"
                                        Height="32" Margin="0,10,0,6" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Save Model" Click="ClsSaveModel_Click" Background="#F1F5F9" Foreground="#172B45" Height="28" Padding="10,0" Margin="0,0,6,6"/>
                                    <Button Content=" Load Model" Click="ClsLoadModel_Click" Background="#F1F5F9" Foreground="#172B45" Height="28" Padding="10,0" Margin="0,0,0,6"/>
                                </StackPanel>
                                <TextBlock x:Name="ClsPredictResult" Foreground="#172B45"
                                           FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <!-- RIGHT: confusion matrix + per-class chart -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <local:CrossValidationTable x:Name="ClsCvTable"/>
                        <Border Background="#FFFFFF" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Confusion Matrix (Test Set)" Foreground="#087F73"
                                           FontSize="14" FontWeight="Bold" Margin="5,0,0,5"/>
                                <Canvas x:Name="ClsConfCanvas" Height="320"
                                        Background="#FFFFFF" ClipToBounds="True"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FFFFFF" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Per-Class F1 Score" Foreground="#087F73"
                                           FontSize="14" FontWeight="Bold" Margin="5,0,0,5"/>
                                <lvc:CartesianChart x:Name="ClsF1Chart" Height="240"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FFFFFF" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Per-Class Metrics" Foreground="#087F73"
                                           FontSize="14" FontWeight="Bold" Margin="5,0,0,5"/>
                                <DataGrid x:Name="ClsMetricsGrid"
                                          Background="#FFFFFF" Foreground="#172B45"
                                          RowBackground="#FFFFFF" AlternatingRowBackground="#F1F5F9"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E7EF"
                                          BorderThickness="0" IsReadOnly="True" AutoGenerateColumns="True"
                                          HeadersVisibility="Column" CanUserAddRows="False" FontSize="12"
                                          MaxHeight="260">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#E2E7EF"/>
                                            <Setter Property="Foreground" Value="#087F73"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderBrush" Value="#F4F6FA"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </TabItem>
        <!-- ==================== TAB 5: CLUSTERING ==================== -->
        <TabItem Header=" Clustering">
            <Grid Background="#F4F6FA" IsVisibleChanged="ClustPanel_IsVisibleChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <Border Background="#FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Clustering" Foreground="#087F73" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                                <TextBlock Text="Algorithm" Foreground="#172B45" FontSize="13"/>
                                <ComboBox x:Name="CmbClustAlgo" Background="#F1F5F9" Foreground="#172B45" FontSize="13" Padding="8,5" Margin="0,3,0,10" SelectedIndex="0" SelectionChanged="ClustAlgo_Changed">
                                    <ComboBoxItem Content="K-Means"/>
                                    <ComboBoxItem Content="DBSCAN"/>
                                    <ComboBoxItem Content="Hierarchical"/>
                                    <ComboBoxItem Content="Fuzzy C-Means"/>
                                </ComboBox>
                                <!-- K based (KMeans/Hierarchical/Fuzzy) -->
                                <StackPanel x:Name="ClustKParams">
                                    <TextBlock Text="Clusters (k)" Foreground="#172B45" FontSize="13"/>
                                    <TextBox x:Name="TxtClustK" Text="3" FontSize="13" Background="#F1F5F9" Foreground="#172B45" Padding="8,5" BorderBrush="#E2E7EF" Margin="0,3,0,10"/>
                                </StackPanel>
                                <StackPanel x:Name="ClustIterParams">
                                    <TextBlock Text="Iterations" Foreground="#172B45" FontSize="13"/>
                                    <TextBox x:Name="TxtClustIter" Text="100" FontSize="13" Background="#F1F5F9" Foreground="#172B45" Padding="8,5" BorderBrush="#E2E7EF" Margin="0,3,0,10"/>
                                </StackPanel>
                                <StackPanel x:Name="ClustFuzzyParams" Visibility="Collapsed">
                                    <TextBlock Text="Fuzziness (m)" Foreground="#172B45" FontSize="13"/>
                                    <TextBox x:Name="TxtClustM" Text="2.0" FontSize="13" Background="#F1F5F9" Foreground="#172B45" Padding="8,5" BorderBrush="#E2E7EF" Margin="0,3,0,10"/>
                                </StackPanel>
                                <StackPanel x:Name="ClustDbscanParams" Visibility="Collapsed">
                                    <TextBlock Text="Epsilon (eps)" Foreground="#172B45" FontSize="13"/>
                                    <TextBox x:Name="TxtClustEps" Text="0.8" FontSize="13" Background="#F1F5F9" Foreground="#172B45" Padding="8,5" BorderBrush="#E2E7EF" Margin="0,3,0,10"/>
                                    <TextBlock Text="Min Points" Foreground="#172B45" FontSize="13"/>
                                    <TextBox x:Name="TxtClustMinPts" Text="5" FontSize="13" Background="#F1F5F9" Foreground="#172B45" Padding="8,5" BorderBrush="#E2E7EF" Margin="0,3,0,10"/>
                                </StackPanel>
                                <StackPanel x:Name="ClustLinkParams" Visibility="Collapsed">
                                    <TextBlock Text="Linkage" Foreground="#172B45" FontSize="13"/>
                                    <ComboBox x:Name="CmbClustLinkage" Background="#F1F5F9" Foreground="#172B45" FontSize="13" Padding="8,5" Margin="0,3,0,10" SelectedIndex="1">
                                        <ComboBoxItem Content="single"/>
                                        <ComboBoxItem Content="average"/>
                                        <ComboBoxItem Content="complete"/>
                                    </ComboBox>
                                </StackPanel>
                                <Button x:Name="BtnClustRun" Content="▶  RUN CLUSTERING" Click="ClustRun_Click" Background="#087F73" Foreground="#F4F6FA" FontWeight="Bold" FontSize="15" Padding="10,12" BorderThickness="0" Cursor="Hand" Margin="0,6,0,0"/>
                                <ProgressBar x:Name="ClustProgress" Height="5" Margin="0,10,0,0" IsIndeterminate="False" Visibility="Collapsed" Background="#F1F5F9" Foreground="#087F73"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Results" Foreground="#087F73" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBox x:Name="TxtClustResults" Foreground="#172B45" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap" IsReadOnly="True" IsTabStop="False" BorderThickness="0" Background="Transparent" Cursor="IBeam" Text="Run clustering to see results."/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FFFFFF" CornerRadius="8" Padding="15">
                            <StackPanel>
                                <TextBlock Text="Assign a point to a cluster" Foreground="#087F73" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                                <StackPanel x:Name="ClustPredictInputs"/>
                                <Button Content="Assign" Click="ClustPredict_Click" Background="#E2E7EF" Foreground="#087F73" Height="32" Margin="0,10,0,6" FontWeight="Bold"/>
                                <TextBlock x:Name="ClustPredictResult" Foreground="#172B45" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <Border Background="#FFFFFF" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Clusters (PC1 vs PC2)" Foreground="#087F73" FontSize="14" FontWeight="Bold" Margin="5,0,0,5"/>
                                <lvc:CartesianChart x:Name="ClustScatter" Height="460"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </TabItem>
        <!-- ==================== TAB 6: COMPARE ==================== -->
        <TabItem Header=" Compare">
            <Grid Background="#F4F6FA" IsVisibleChanged="ComparePanel_IsVisibleChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
                    <TextBlock Text="Model Comparison" Foreground="#087F73" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Content=" Refresh" Click="CompareRefresh_Click" Background="#E2E7EF" Foreground="#172B45" Padding="12,6" Margin="20,0,0,0" BorderThickness="0" Cursor="Hand"/>
                    <Button Content=" Clear History" Click="CompareClear_Click" Background="#E2E7EF" Foreground="#ff6b6b" Padding="12,6" Margin="8,0,0,0" BorderThickness="0" Cursor="Hand"/>
                    <TextBlock x:Name="TxtCompareInfo" Text="" Foreground="#64748B" VerticalAlignment="Center" Margin="15,0,0,0"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <Border Background="#FFFFFF" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="All runs (this session)" Foreground="#087F73" FontSize="14" FontWeight="Bold" Margin="5,0,0,5"/>
                                <DataGrid x:Name="CompareGrid" Background="#FFFFFF" Foreground="#172B45"
                                          RowBackground="#FFFFFF" AlternatingRowBackground="#F1F5F9"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E7EF"
                                          BorderThickness="0" IsReadOnly="True" AutoGenerateColumns="True"
                                          HeadersVisibility="Column" CanUserAddRows="False" FontSize="12" MaxHeight="260">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#E2E7EF"/>
                                            <Setter Property="Foreground" Value="#087F73"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderBrush" Value="#F4F6FA"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="#FFFFFF" CornerRadius="8" Padding="10" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Regression — R² (higher = better)" Foreground="#087F73" FontSize="13" FontWeight="Bold" Margin="5,0,0,5"/>
                                    <lvc:CartesianChart x:Name="CompareRegChart" Height="260"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="8" Padding="10" Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Regression — RMSE (lower = better)" Foreground="#087F73" FontSize="13" FontWeight="Bold" Margin="5,0,0,5"/>
                                    <lvc:CartesianChart x:Name="CompareRmseChart" Height="260"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Background="#FFFFFF" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Classification — Accuracy % &amp; Macro-F1" Foreground="#087F73" FontSize="13" FontWeight="Bold" Margin="5,0,0,5"/>
                                <lvc:CartesianChart x:Name="CompareClsChart" Height="260"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </TabItem>
        <!-- ==================== TAB 7: VISUALIZATION ==================== -->
        <TabItem Header=" Visualization">
            <Grid Background="#F4F6FA" IsVisibleChanged="VizPanel_IsVisibleChanged">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Left: controls -->
                    <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Chart Builder" Foreground="#087F73"
                               FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                            <TextBlock Text="Chart type" Foreground="#172B45" Margin="0,4"/>
                            <ComboBox x:Name="VizChartTypeCombo" Height="28" SelectedIndex="0" SelectionChanged="VizChartType_Changed"
                                      Background="#F1F5F9" Foreground="#172B45">
                                <ComboBoxItem Content="Line"/>
                                <ComboBoxItem Content="Bar"/>
                                <ComboBoxItem Content="Scatter"/>
                                <ComboBoxItem Content="Pie"/>
                                <ComboBoxItem Content="Radar"/>
                            </ComboBox>
                            <TextBlock Text="X / Category" Foreground="#172B45" Margin="0,10,0,4"/>
                            <ComboBox x:Name="VizXCombo" Height="28" Background="#F1F5F9" Foreground="#172B45"/>
                            <TextBlock Text="Y / Value" Foreground="#172B45" Margin="0,10,0,4"/>
                            <ComboBox x:Name="VizYCombo" Height="28" Background="#F1F5F9" Foreground="#172B45"/>
                            <TextBlock Text="Y2 (Line only, optional)" Foreground="#172B45" Margin="0,10,0,4"/>
                            <ComboBox x:Name="VizY2Combo" Height="28" Background="#F1F5F9" Foreground="#172B45"/>
                            <TextBlock Text="Row to compare (Radar)" Foreground="#172B45" Margin="0,10,0,4"/>
                            <TextBox x:Name="VizRowBox" Text="0" Height="26"
                                     Background="#F1F5F9" Foreground="#172B45" BorderBrush="#E2E7EF"/>
                            <Button Content="Plot" Click="VizPlot_Click"
                            Background="#E2E7EF" Foreground="#087F73"
                            Height="34" Margin="0,16,0,0" FontWeight="Bold"/>
                            <Button x:Name="VizSortButton" Content="Sort X: min → max" Click="VizSort_Click" Background="#E5F3F0" Foreground="#087F73" Padding="8,9" Margin="0,8,0,0" ToolTip="Sort plotted rows by X, keeping each Y and Y2 paired with its original X. Click again to restore source order."/>
                            <TextBlock x:Name="VizStatus" Foreground="#172B45"
                               TextWrapping="Wrap" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Right: chart host (three overlaid controls, toggled in code-behind) -->
                    <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="8" Margin="0">
                        <Grid>
                            <lvc:CartesianChart x:Name="VizCartesian"/>
                            <lvc:PieChart       x:Name="VizPie"   Visibility="Collapsed"/>
                            <lvc:PolarChart     x:Name="VizPolar" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>

        </TabControl>
    </Grid>
</Page>
