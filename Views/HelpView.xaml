<Page x:Class="ArchiAI.Views.HelpView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F4F6FA">
 <Grid Margin="18,14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,12">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="Search the user guide" Foreground="#172B45" FontSize="16" FontWeight="SemiBold"/>
     <DockPanel Margin="0,8,16,0">
      <Button DockPanel.Dock="Right" Content="Clear" Click="Clear_Click" Foreground="#087F73" Background="#EDF6F3" Padding="12,5" Margin="8,0,0,0"/>
      <TextBox x:Name="SearchBox" TextChanged="Search_Changed" FontSize="14" Padding="10,6" Background="#F4F6FA" Foreground="#172B45" BorderBrush="#E2E7EF" AutomationProperties.Name="Search all help topics" ToolTip="Search titles, instructions, settings and troubleshooting. Example: PCA prediction"/>
     </DockPanel>
    </StackPanel>
    <Button Grid.Column="1" Content="Back to workspace" Click="Back_Click" VerticalAlignment="Center" Foreground="#087F73" Background="White" BorderBrush="#D9E5E2" Padding="12,8"/>
    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
     <Button x:Name="SaveCheatSheetButton" Content="Save cheat sheet PDF" Click="SaveCheatSheet_Click" Foreground="#087F73" Background="#EDF6F3" Padding="12,7" ToolTip="Save the embedded two-page A4 machine-learning reference"/>
     <Button x:Name="OpenCheatSheetButton" Content="Open / print cheat sheet" Click="OpenCheatSheet_Click" Foreground="#087F73" Background="White" BorderBrush="#D9E5E2" Padding="12,7" Margin="8,0,0,0" ToolTip="Open in your PDF reader, then press Ctrl+P to print"/>
     <TextBlock Text="Illustrated · 2 pages · A4" Foreground="#64748B" VerticalAlignment="Center" Margin="12,0,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="270" MinWidth="230"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="White" CornerRadius="10" Padding="12">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="CONTENTS" FontSize="10" Foreground="#087F73" FontWeight="Bold" Margin="2,0,0,8"/>
      <ComboBox x:Name="CategoryBox" SelectionChanged="Category_Changed" Padding="6,4" Foreground="#172B45" AutomationProperties.Name="Filter help category"/>
      <TextBlock x:Name="ResultsStatus" Foreground="#64748B" TextWrapping="Wrap" Margin="2,10,0,8"/>
     </StackPanel>
     <ListBox x:Name="TopicsList" SelectionChanged="Topic_Changed" BorderThickness="0" Background="White" Foreground="#172B45" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Help search results">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,10"/><Setter Property="Margin" Value="0,0,0,5"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><StackPanel>
       <TextBlock Text="{Binding Category}" Foreground="#087F73" FontSize="10"/>
       <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="13" Margin="0,3,0,5"/>
       <TextBlock Text="{Binding Snippet}" TextWrapping="Wrap" Foreground="#64748B" FontSize="11" MaxHeight="64" TextTrimming="CharacterEllipsis"/>
      </StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
   <Border Grid.Column="2" Background="White" CornerRadius="10">
    <FlowDocumentScrollViewer x:Name="ArticleViewer" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False" IsSelectionEnabled="True"/>
   </Border>
  </Grid>
 </Grid>
</Page>
