<Window x:Class="ArchiAI.Helpers.ArrowTextDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arrow Label" Height="160" Width="350"
        WindowStartupLocation="CenterOwner"
        Background="#1a1a2e" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Enter label text (e.g. material name):" 
                   Foreground="#1F2430" FontSize="14" Margin="0,0,0,10"/>
        <TextBox x:Name="TxtLabel" FontSize="14" Padding="8,5"
                 Background="#16213e" Foreground="#1F2430" BorderBrush="#233554"
                 AcceptsReturn="False"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="OK" Width="80" Height="30"
                    Background="#64ffda" Foreground="#0a192f" BorderThickness="0"
                    FontWeight="Bold" Click="Ok_Click" IsDefault="True" Cursor="Hand"/>
            <Button Content="Cancel" Width="80" Height="30" Margin="10,0,0,0"
                    Background="#233554" Foreground="#1F2430" BorderThickness="0"
                    Click="Cancel_Click" IsCancel="True" Cursor="Hand"/>
        </StackPanel>
    </StackPanel>
</Window>
