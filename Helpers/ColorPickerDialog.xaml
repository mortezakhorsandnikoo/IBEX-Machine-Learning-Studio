<Window x:Class="ArchiAI.Helpers.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick Color" Height="400" Width="300"
        WindowStartupLocation="CenterOwner"
        Background="#1a1a2e" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">
            <TextBlock Text="Red" Foreground="Red" FontSize="13"/>
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="SR" Width="200" Minimum="0" Maximum="255" Value="0"
                        ValueChanged="S_Changed" IsSnapToTickEnabled="True" TickFrequency="1"/>
                <TextBlock x:Name="LR" Text="0" Foreground="#1F2430" Width="30" Margin="5,0,0,0"/>
            </StackPanel>

            <TextBlock Text="Green" Foreground="LimeGreen" FontSize="13" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="SG" Width="200" Minimum="0" Maximum="255" Value="0"
                        ValueChanged="S_Changed" IsSnapToTickEnabled="True" TickFrequency="1"/>
                <TextBlock x:Name="LG" Text="0" Foreground="#1F2430" Width="30" Margin="5,0,0,0"/>
            </StackPanel>

            <TextBlock Text="Blue" Foreground="CornflowerBlue" FontSize="13" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="SB" Width="200" Minimum="0" Maximum="255" Value="0"
                        ValueChanged="S_Changed" IsSnapToTickEnabled="True" TickFrequency="1"/>
                <TextBlock x:Name="LB" Text="0" Foreground="#1F2430" Width="30" Margin="5,0,0,0"/>
            </StackPanel>

            <TextBlock Text="Preview:" Foreground="#a8b2d1" FontSize="12" Margin="0,12,0,4"/>
            <Border x:Name="Prev" Height="40" CornerRadius="6"
                    Background="Black" BorderBrush="#444" BorderThickness="1"/>

            <TextBlock Text="Presets:" Foreground="#a8b2d1" FontSize="12" Margin="0,12,0,4"/>
            <WrapPanel>
                <Button Background="Black" Width="28" Height="28" Margin="2"
                        BorderThickness="1" BorderBrush="#555" Click="P" Tag="0,0,0"/>
                <Button Background="White" Width="28" Height="28" Margin="2"
                        BorderThickness="1" BorderBrush="#555" Click="P" Tag="255,255,255"/>
                <Button Background="Red" Width="28" Height="28" Margin="2"
                        BorderThickness="1" BorderBrush="#555" Click="P" Tag="255,0,0"/>
                <Button Background="Blue" Width="28" Height="28" Margin="2"
                        BorderThickness="1" BorderBrush="#555" Click="P" Tag="0,0,255"/>
                <Button Background="Green" Width="28" Height="28" Margin="2"
                        BorderThickness="1" BorderBrush="#555" Click="P" Tag="0,128,0"/>
                <Button Background="Yellow" Width="28" Height="28" Margin="2"
                        BorderThickness="1" BorderBrush="#555" Click="P" Tag="255,255,0"/>
                <Button Background="Orange" Width="28" Height="28" Margin="2"
                        BorderThickness="1" BorderBrush="#555" Click="P" Tag="255,165,0"/>
                <Button Background="Cyan" Width="28" Height="28" Margin="2"
                        BorderThickness="1" BorderBrush="#555" Click="P" Tag="0,255,255"/>
                <Button Background="Purple" Width="28" Height="28" Margin="2"
                        BorderThickness="1" BorderBrush="#555" Click="P" Tag="128,0,128"/>
                <Button Background="HotPink" Width="28" Height="28" Margin="2"
                        BorderThickness="1" BorderBrush="#555" Click="P" Tag="255,105,180"/>
            </WrapPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="OK" Width="80" Height="32" Margin="0,0,10,0"
                        Background="#64ffda" Foreground="#0a192f" BorderThickness="0"
                        FontWeight="Bold" FontSize="14" Click="Ok" IsDefault="True" Cursor="Hand"/>
                <Button Content="Cancel" Width="80" Height="32"
                        Background="#233554" Foreground="#1F2430" BorderThickness="0"
                        FontSize="14" Click="Cancel" IsCancel="True" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
